# Development: Vite proxies /api to this origin (the Tirvona_ride backend).
VITE_API_PROXY_TARGET=http://localhost:5100

# Production: absolute API origin baked into the bundle. Leave empty in
# development so requests go through the Vite proxy above.
VITE_API_URL=

# Google Maps JavaScript API key for the live driver map. Create a *browser* key
# restricted to this panel's origin. Without it the live pages show lists only.
VITE_GOOGLE_MAPS_API_KEY=
